# Example environment for local development. Never commit .env.
# The app reads real environment variables; it does not load this file itself.
PERIODICOOL_CONFIG_DIR=./dev-data/config
PERIODICOOL_LIBRARY_DIR=./dev-data/library
PERIODICOOL_DOWNLOADS_DIR=./dev-data/downloads
PERIODICOOL_PORT=8383
TZ=UTC

# Used by fixture collection in build step 2
PROWLARR_URL=http://prowlarr.local:9696
PROWLARR_API_KEY=
SABNZBD_URL=http://sabnzbd.local:8080
SABNZBD_API_KEY=
